# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require

# LLM provider config. Defaults target Groq's OpenAI-compatible API running an
# open-weight model, so this can be swapped later (e.g. to Anthropic's API, or
# another OpenAI-compatible host) by changing these three values only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=openai/gpt-oss-120b

# To use a local Ollama install instead (e.g. when hitting a hosted
# provider's rate limits), comment the three lines above and use:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=<a model you've pulled that supports tools, e.g. llama3.2>
# This only works when running the app locally (`npm run dev`) -- the
# deployed site runs on Netlify's servers and can't reach your machine.
# If prompt processing is slow on your hardware, QUESTION_BANK_EXAMPLES=0
# below trims the interview prompt a lot for faster local iteration.

# How many example questions per category to embed in the interview
# prompt (default 4). 0 drops the question bank from the prompt entirely --
# much faster on a small/local/CPU-only model, at some cost to how well the
# interviewer improvises within a category.
QUESTION_BANK_EXAMPLES=4

# Shared secret for the /admin.html testing page (list-all-records, delete).
# Generate one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_KEY=replace-me
