# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values. Next.js reads .env.local natively, and the migration script is
# pointed at the same file so there is only ever one place to look.

# Neon: POOLED connection. Used by the app at runtime.
# Dashboard → Connect → make sure "Connection pooling" is ON.
# The host contains "-pooler".
DATABASE_URL=

# Neon: DIRECT connection. Used only by migrations.
# Same dialog with "Connection pooling" OFF — host has no "-pooler".
# Schema changes over a pooled connection are unreliable.
DATABASE_URL_UNPOOLED=

# Anthropic API key for the interview agent.
ANTHROPIC_API_KEY=

# Better Auth. Generate the secret with: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Local only — pins the auth origin. Leave UNSET on Netlify: the app then checks
# the request host against handingover.netlify.app and its deploy previews.
BETTER_AUTH_URL=http://localhost:3000

# Anyone creating an account must enter this. If unset, sign-up is closed.
SIGNUP_ACCESS_CODE=
