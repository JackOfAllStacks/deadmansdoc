# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require

# LLM provider config. Defaults target Groq's OpenAI-compatible API running an
# open-weight model, so this can be swapped later (e.g. to Anthropic's API, or
# another OpenAI-compatible host) by changing these three values only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=openai/gpt-oss-120b
